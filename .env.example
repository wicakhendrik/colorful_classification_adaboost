# Copy to .env and edit:  cp .env.example .env
APP_PORT=8000
# 0.0.0.0 = reachable from outside (local testing); 127.0.0.1 = only via reverse proxy (VPS, recommended)
APP_BIND=127.0.0.1
DJANGO_DEBUG=False
# generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,example.com
# for HTTPS behind a reverse proxy (Django 3.1: host only, no scheme)
DJANGO_CSRF_TRUSTED_ORIGINS=
